# MCM Analytics — Secrets Configuration
# Copy this file to one of:
#   ~/.config/mcm-analytics/secrets.toml  (recommended, outside repo)
#   .streamlit/secrets.toml               (Streamlit native location)
#
# No Deribit API key needed — all endpoints are public.
# Only Telegram credentials are required (for report blasting).

[telegram]
bot_token = "YOUR_TELEGRAM_BOT_TOKEN_HERE"
chat_id = "YOUR_TELEGRAM_CHAT_ID_HERE"

# Optional. Lets the Ecoinometrics Charts page queue
# .github/workflows/update_ecoinometrics_data.yml so Farside, FRED, and Fed
# tone CSVs are committed to main (the in-app refresh itself does not need
# this; it only updates the current session). Fine-grained PAT for
# seanbmcnulty/mcm-analytics with Actions: Read and write. Contents can stay
# at No access — the workflow commits with its own GITHUB_TOKEN. Leave blank
# to keep the button, which then explains this and does not call GitHub.
[github]
dispatch_token = ""
