# MCM Analytics — Secrets Configuration
# Copy this file to one of:
#   ~/.config/mcm-analytics/secrets.toml  (recommended, outside repo)
#   .streamlit/secrets.toml               (Streamlit native location)
#
# No Deribit API key needed — all endpoints are public.
# Only Telegram credentials are required (for report blasting).

[telegram]
bot_token = "YOUR_TELEGRAM_BOT_TOKEN_HERE"
chat_id = "YOUR_TELEGRAM_CHAT_ID_HERE"
